# Copy to .env (gitignored) and fill in. Used by the evals/ pipeline only —
# the FreeCAD plugin itself reads its key from FreeCAD preferences.
# Real environment variables take precedence over anything set here.

# Models default to OpenRouter, so this is the only key normally needed.
OPENROUTER_API_KEY=

# Only needed if you point a model at a provider directly.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# Model overrides (defaults shown). The synthesizer is deliberately a
# different model from the judge.
#EVAL_MODEL=openrouter/anthropic/claude-sonnet-4-5
#EVAL_JUDGE_MODEL=openrouter/anthropic/claude-opus-4-8
#EVAL_SYNTH_MODEL=openrouter/anthropic/claude-sonnet-4-5

# Reasoning effort for the agent under test: off | low | medium | high
#EVAL_REASONING=off

# Override the provider base URL (rarely needed).
#EVAL_API_BASE=
